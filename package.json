{
  "name": "imodureel",
  "version": "0.1.78",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server\"",
    "build": "node --check electron/main.cjs && node --check electron/preload.cjs && tsc --noEmit && vite build",
    "start": "electron .",
    "dist:mac": "node scripts/check-package.cjs darwin && npm run build && electron-builder --mac --config.electronDist=node_modules/electron/dist",
    "dist:win": "node scripts/check-package.cjs win32 && npm run build && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node scripts/smoke-desktop.cjs",
    "test:comfy": "node scripts/smoke-comfy.cjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ffmpeg-static": "^5.2.0",
    "libheif-js": "1.23.5",
    "pngjs": "7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.imodureel.desktop",
    "productName": "iModuReel",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "electron/heif-worker.cjs",
      "node_modules/libheif-js/**/*",
      "node_modules/pngjs/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "description": "Desktop AI video production with ComfyUI and FFmpeg"
}
